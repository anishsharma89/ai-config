# Never commit credentials. Claude Code's own config file holds live tokens
# when MCP headers are inlined rather than referenced via env vars.
.claude.json
.claude/settings.local.json
.env
.env.*
*.pem
*.key

# Local machine state, not configuration
.claude/projects/
.claude/sessions/
.claude/history.jsonl
.claude/shell-snapshots/
.claude/cache/
.DS_Store
